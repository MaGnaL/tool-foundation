{
  "name": "@magnal/prettier-config",
  "version": "4.3.0",
  "description": "Prettier config for my projects",
  "repository": {
    "type": "git",
    "url": "https://github.com/MaGnaL/tool-foundation.git"
  },
  "homepage": "https://github.com/MaGnaL/tool-foundation",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    "./package.json": "./package.json",
    ".": {
      "@tool-foundation/source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!**/*.tsbuildinfo"
  ],
  "dependencies": {
    "tslib": "^2.3.0",
    "prettier-plugin-organize-imports": "4.1.0",
    "prettier-plugin-tailwindcss": "0.7.1"
  },
  "peerDependencies": {
    "prettier": "^3"
  }
}
